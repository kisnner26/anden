{
  "expo": {
    "name": "Andén",
    "slug": "anden",
    "icon": "./assets/marca/icono.png",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "anden",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.kisnner.anden",
      "infoPlist": {
        "NSSupportsLiveActivities": true,
        "NSMicrophoneUsageDescription": "Andén usa el micrófono solo mientras le hablás al asistente."
      }
    },
    "android": {
      "package": "com.kisnner.anden",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "backgroundColor": "#0B0B09",
        "foregroundImage": "./assets/marca/icono-adaptativo.png",
        "monochromeImage": "./assets/marca/icono-monocromatico.png"
      }
    },
    "web": {
      "output": "server"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F1E8",
          "dark": {
            "backgroundColor": "#121210",
            "image": "./assets/marca/arranque-oscuro.png"
          },
          "image": "./assets/marca/arranque-claro.png",
          "imageWidth": 300,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Andén usa tu galería solo para que elijas la foto de tu perfil.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Andén usa tu ubicación solo mientras la app está abierta, para proponerte la terminal más cercana.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Andén usa Face ID solo para abrir la app y mostrar tus boletos."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ],
      "@bacons/apple-targets",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Andén usa el micrófono solo mientras le hablás al asistente.",
          "speechRecognitionPermission": "Andén usa el dictado del teléfono para entender lo que le preguntás al asistente."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
