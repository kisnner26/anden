{
  "expo": {
    "name": "Andén",
    "slug": "anden",
    "icon": "./assets/marca/icono.png",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "anden",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.kisnner.anden"
    },
    "android": {
      "package": "com.kisnner.anden",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "backgroundColor": "#0E0F11",
        "foregroundImage": "./assets/marca/icono-adaptativo.png",
        "monochromeImage": "./assets/marca/icono-monocromatico.png"
      }
    },
    "web": {
      "output": "server"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E0F11",
          "image": "./assets/marca/arranque.png",
          "imageWidth": 220,
          "resizeMode": "contain"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
